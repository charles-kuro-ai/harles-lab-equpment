{
  "name": "harles-lab-equipment",
  "version": "1.0.0",
  "description": "Harles Lab Equipment - Laboratory Equipment Supplier Website",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch",
    "serve": "npx serve . -l 3000",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
