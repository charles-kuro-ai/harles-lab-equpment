# HARLES LAB EQUIPMENT — ENVIRONMENT VARIABLES
# ================================================
# Copy this file to .env for local development.
# NEVER commit .env or any file containing real secrets to Git.
# In production, add these as Environment Variables in your Vercel project:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# See README.md for full setup instructions.

# ── Telegram Bot (REQUIRED for Telegram enquiry feature) ──────────────────────
# Obtain from @BotFather on Telegram. Keep this secret — never put it in
# frontend JavaScript, HTML, or any public file.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# The numeric chat ID of the account or group that should receive enquiries.
# See README.md for how to find your chat ID.
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ── Node environment ───────────────────────────────────────────────────────────
# Set to "development" locally. Vercel sets this automatically in production.
NODE_ENV=development
